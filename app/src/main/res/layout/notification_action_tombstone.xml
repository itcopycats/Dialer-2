<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:enabled="false"
    android:orientation="0"
    android:id="@id/action_container"
    android:background="@null"
    android:layout_width="0dp"
    android:layout_height="0.00dp"
    android:layout_weight="1.0"
    android:paddingStart="0.00dp"
    style="@style/Widget.Compat.NotificationActionContainer">
    <ImageView
        android:enabled="false"
        android:layout_gravity="0x800013"
        android:id="@id/action_image"
        android:layout_width="@dimen/notification_action_icon_size"
        android:layout_height="@dimen/notification_action_icon_size"
        android:scaleType="7"
        android:alpha="0.5">
    </ImageView>
    <TextView
        android:enabled="false"
        android:ellipsize="3"
        android:layout_gravity="0x800013"
        android:id="@id/action_text"
        android:clickable="false"
        android:layout_width="-2"
        android:layout_height="-2"
        android:singleLine="true"
        android:alpha="0.5"
        android:paddingStart="0.00dp"
        style="@style/Widget.Compat.NotificationActionText">
    </TextView>
</LinearLayout>
